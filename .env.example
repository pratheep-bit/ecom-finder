# Application Configuration
APP_NAME="Product Finder API"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","http://127.0.0.1:5500"]

# Scraper Configuration
# Modes: "live" (only live scraping), "hybrid" (live first with intelligent fallback if WAF/CAPTCHA encountered), "mock" (for offline/testing)
SCRAPER_MODE=hybrid
REQUEST_TIMEOUT_SECONDS=12.0
MAX_RESULTS_PER_MARKETPLACE=40
AMAZON_BASE_URL="https://www.amazon.in"
FLIPKART_BASE_URL="https://www.flipkart.com"

# Bayesian Rating Parameters
BAYESIAN_MIN_REVIEWS=50
BAYESIAN_BASELINE_RATING=4.0

# Ranking Weights (Must sum to 1.0)
WEIGHT_RATING_CONFIDENCE=0.40
WEIGHT_PRICE_VALUE=0.30
WEIGHT_REQUIREMENTS=0.20
WEIGHT_AVAILABILITY=0.10

# Budget Constraints
DEFAULT_OVER_BUDGET_ALLOWANCE_PCT=10.0

# Rate Limiting
RATE_LIMIT_SEARCH="15/minute"
